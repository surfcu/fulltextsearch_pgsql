{
    "name": "surfcu/fulltextsearch_pgsql",
    "description": "PostgreSQL platform for Nextcloud Full Text Search",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "surfcu",
            "homepage": "https://github.com/surfcu"
        }
    ],
    "require": {
        "php": "^8.1",
        "smalot/pdfparser": "2.12.5"
    },
    "replace": {
        "symfony/polyfill-mbstring": "*"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.5",
        "nextcloud/ocp": "dev-stable30",
        "vimeo/psalm": "^5.26"
    },
    "autoload": {
        "psr-4": {
            "OCA\\FullTextSearch_PgSql\\": "lib/"
        }
    },
    "scripts": {
        "scope-pdfparser": "php scripts/scope-pdfparser.php",
        "post-install-cmd": [
            "@scope-pdfparser"
        ],
        "post-update-cmd": [
            "@scope-pdfparser"
        ],
        "psalm": "psalm --no-cache --threads=1",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
