{
    "name": "surfcu/fulltextsearch_pgsql",
    "description": "PostgreSQL platform for Nextcloud Full Text Search",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "surfcu",
            "homepage": "https://github.com/surfcu"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-stable30",
        "vimeo/psalm": "^5.26"
    },
    "autoload": {
