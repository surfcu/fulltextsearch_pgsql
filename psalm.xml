<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
    phpVersion="8.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="lib"/>
        <ignoreFiles>
            <directory name="lib/Vendor"/>
        </ignoreFiles>
    </projectFiles>
    <extraFiles>
        <directory name="lib/Vendor"/>
        <directory name="vendor/nextcloud/ocp"/>
    </extraFiles>
    <stubs>
        <file name="tests/stubs/symfony-console.php"/>
        <file name="tests/stubs/IndexDocument.php"/>
        <file name="tests/stubs/DocumentAccess.php"/>
        <file name="tests/stubs/psr-log.php"/>
    </stubs>
    <issueHandlers>
        <!-- Raised inside OCP's own Controller::buildResponse in the Nextcloud 35 API, not in this app. -->
        <InvalidTemplateParam>
            <errorLevel type="suppress">
                <directory name="vendor/nextcloud/ocp"/>
            </errorLevel>
        </InvalidTemplateParam>
        <UndefinedClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\*"/>
            </errorLevel>
        </UndefinedClass>
        <UndefinedDocblockClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\*"/>
            </errorLevel>
        </UndefinedDocblockClass>
    </issueHandlers>
</psalm>
